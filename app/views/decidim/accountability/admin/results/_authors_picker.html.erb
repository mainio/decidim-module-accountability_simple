<% selected_authors = form.object.authors.map { |author| { key: "label", value: { value: author.id, label: "#{author.name} (#{author.nickname})" } } } %>
<div data-autocomplete="<%= {
  name: "#{form.object_name}[author_ids][]",
  options: [],
  placeholder: t(".search_placeholder", collection: t(".collection_name")),
  selected: selected_authors,
  searchPromptText: t(".search_prompt", default: t("autocomplete.search_prompt", scope: "decidim.admin")),
  noResultsText: t(".no_results", default: t("autocomplete.no_results", scope: "decidim.admin")),
  mode: "multi"
}.to_json %>">
</div>
