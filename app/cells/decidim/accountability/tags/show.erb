<%= content_tag :div, class: tags_classes do %>
  <% model.taxonomies.each do |taxonomy| %>
    <span>
      <%= taxonomy_name(taxonomy) %>
    </span>
  <% end %>

  <% model.tags.each do |tag| %>
    <%= link_to tag_path(tag), class: "label primary" do %>
      <span class="show-for-sr">
        <%= t("decidim.tags.filter_results_for_tag", tag: tag_name(tag)) %>
      </span>
      <span aria-hidden="true">
        <%= tag_name(tag) %>
      </span>
    <% end %>
  <% end %>
<% end %>
